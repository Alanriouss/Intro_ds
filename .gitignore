# Raw CDC files (1.2 GB) are never committed
data/raw/
*.XPT
*.xpt

# Processed data: only the clean analysis file is tracked (see data/README.md, section 8)
data/processed/*
!data/processed/brfss2023_clean.parquet

# Exports, archives and local clutter
*.zip
notebooks/*.html
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
